# Copy to backend/.env for local development.
# On Vercel: Project -> Settings -> Environment Variables (same names).

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Atlas -> Network Access must allow 0.0.0.0/0 for Vercel)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/email_sender?retryWrites=true&w=majority

# Dashboard admin login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password

# Long random strings (at least 32 characters). Generate with: openssl rand -hex 32
JWT_SECRET=
# Vercel Cron sends this automatically as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Gmail sending (use a Gmail App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your16charapppassword
SMTP_FROM="Your Name <yourgmail@gmail.com>"

# Sending limits
DEFAULT_TIMEZONE=Asia/Kolkata
GLOBAL_DAILY_SEND_LIMIT=30
DEFAULT_DAILY_LIMIT=30

# Optional
MAX_FILE_SIZE=4194304
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Set to true locally if the deployed Vercel cron should be the only sender
DISABLE_LOCAL_SCHEDULER=false
